{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACKDeck",
  "version": "1.1.0",
  "identifier": "com.alican.ackdeck",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ACKDeck",
        "visible": false,
        "maximized": true,
        "width": 1200,
        "height": 780,
        "minWidth": 700,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "alican",
    "windows": {
      "wix": {
        "upgradeCode": "ac8c228a-564c-5567-b871-ace57ac64afc",
        "language": "tr-TR"
      },
      "nsis": {
        "languages": [
          "Turkish"
        ]
      }
    }
  }
}
